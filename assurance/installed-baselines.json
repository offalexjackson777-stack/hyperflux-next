      "behavior": [
        {"id": "baseline.normal-boot-doctor", "verdict": "passed", "evidence_level": "machine-captured", "summary": "A normal connected boot and desktop login reached Doctor Ready without manual binding.", "limitations": []},
        {"id": "baseline.openrgb-enumeration-control", "verdict": "passed", "evidence_level": "operator-confirmed", "summary": "Stock OpenRGB enumerated exactly the mouse and keyboard and applied independent reversible lighting and effects.", "limitations": []},
        {"id": "baseline.polychromatic-enumeration-control", "verdict": "passed", "evidence_level": "operator-confirmed", "summary": "Stock Polychromatic enumerated both children through stock OpenRazer and exercised the exposed reversible controls.", "limitations": []},
        {"id": "baseline.keyboard-return", "verdict": "passed", "evidence_level": "operator-confirmed", "summary": "Keyboard off and on withdrew and republished one keyboard route while preserving the mouse.", "limitations": ["One ordinary Polychromatic refresh was needed to update its already-open device page during the staged component run."]},
        {"id": "baseline.mouse-return", "verdict": "passed", "evidence_level": "operator-confirmed", "summary": "Mouse off and on withdrew and republished one mouse route while preserving the keyboard.", "limitations": []},
        {"id": "baseline.direct-usb-precedence", "verdict": "passed", "evidence_level": "operator-confirmed", "summary": "Direct USB precedence suppressed the wireless duplicate and the wireless route returned after cable removal.", "limitations": []},
        {"id": "baseline.input-controls", "verdict": "passed", "evidence_level": "operator-confirmed", "summary": "Ordinary input, mouse DPI and scroll controls, and keyboard media and roller controls remained functional.", "limitations": []},
        {"id": "baseline.battery-charging", "verdict": "passed", "evidence_level": "operator-confirmed", "summary": "Battery stayed truthful without a false zero and charging state followed cable removal and reconnection.", "limitations": []},
        {"id": "baseline.reconnect-latency", "verdict": "passed", "evidence_level": "machine-captured", "summary": "Supported child return converged within the bounded fifteen-second live gate without a service restart.", "limitations": []},
        {"id": "baseline.idle-health", "verdict": "passed", "evidence_level": "machine-captured", "summary": "A sixty-second idle sample showed stable RSS, bounded CPU growth, and no bridge or relay warning entries.", "limitations": []},
        {"id": "baseline.mixed-capability-effects", "verdict": "passed", "evidence_level": "operator-confirmed", "summary": "Polychromatic safely filtered Breathing, Starlight, and Reactive to supporting devices while leaving the sibling unchanged.", "limitations": ["Ripple was intentionally excluded from this positive result."]},
        {"id": "baseline.ripple-negative-reproduction", "verdict": "accepted-limitation", "evidence_level": "bounded-negative-reproduction", "summary": "The bounded Ripple run completed 1599 feature exchanges with final input released and did not reproduce the historic latch.", "limitations": ["The first capture watched the wrong click interface and ended before its completeness marker, so causal attribution and universal safety were not proven."]},
        {"id": "baseline.openrgb-quartz-label", "verdict": "accepted-limitation", "evidence_level": "operator-confirmed", "summary": "The false Quartz label also occurs in stock OpenRGB over direct USB and is not treated as HyperFlux identity authority.", "limitations": ["The label remains a cosmetic upstream limitation."]}
