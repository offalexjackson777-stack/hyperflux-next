[Unit]
Description=HyperFlux Next private desktop bridge socket for UID %i
Documentation=man:hyperfluxctl(1)
PartOf=user-runtime-dir@%i.service
Requires=hyperflux-next-bridge.service
After=user-runtime-dir@%i.service hyperflux-next-bridge.service

[Socket]
ListenStream=/run/user/%i/hyperflux-next-bridge.sock
SocketMode=0600
SocketUser=%i
DirectoryMode=0700
RemoveOnStop=yes
Accept=no
FlushPending=yes

[Install]
WantedBy=user-runtime-dir@%i.service
