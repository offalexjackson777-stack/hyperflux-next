{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperflux.dev/schemas/openrazer-native-method-inventory-v1.json",
  "title": "Source-bound OpenRazer native-control method inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "upstream",
    "policy_sha256",
    "metadata_selection_sha256",
    "report_size",
    "source_files",
    "devices"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema": {"const": "hyperflux-openrazer-native-method-inventory-v1"},
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository", "version", "commit", "license_expression"],
      "properties": {
        "id": {"const": "openrazer"},
        "repository": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "license_expression": {"type": "string", "minLength": 1}
      }
    },
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "metadata_selection_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "report_size": {"const": 90},
    "source_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^[A-Za-z0-9_./-]+$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "devices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/device"}
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vendor_id", "product_id", "model_name", "device_kind", "transport_variant"],
      "properties": {
        "vendor_id": {"type": "integer", "minimum": 0, "maximum": 65535},
        "product_id": {"type": "integer", "minimum": 0, "maximum": 65535},
        "model_name": {"type": "string", "minLength": 1},
        "device_kind": {"enum": ["keyboard", "mouse"]},
        "transport_variant": {"enum": ["wireless", "wired"]}
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "wireless_identity",
        "direct_usb_reference",
        "source",
        "methods",
        "qualification_probes"
      ],
      "properties": {
        "profile_id": {"type": "string", "pattern": "^child\\.[a-z0-9.-]+$"},
        "wireless_identity": {"$ref": "#/$defs/identity"},
        "direct_usb_reference": {"$ref": "#/$defs/direct-reference"},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "class_name", "sha256"],
          "properties": {
            "path": {"type": "string"},
            "class_name": {"type": "string"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "origin", "classification", "transport", "readback", "privacy"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,127}$"},
              "origin": {"enum": ["advertised", "common-daemon-api", "device-kind-mixin"]},
              "classification": {
                "enum": ["read-only", "reversible-with-readback", "software-only", "unsafe"]
              },
              "transport": {"enum": ["feature-report", "software-only"]},
              "readback": {
                "oneOf": [
                  {"type": "null"},
                  {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,127}$"}
                ]
              },
              "privacy": {"enum": ["summary-only", "redacted-equality-only"]}
            }
          }
        },
        "qualification_probes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,127}$"}
        }
      }
    },
    "direct-reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vendor_id",
        "product_id",
        "model_name",
        "device_kind",
        "transport_variant",
        "class_name",
        "source_path",
        "source_line"
      ],
      "properties": {
        "vendor_id": {"type": "integer", "minimum": 0, "maximum": 65535},
        "product_id": {"type": "integer", "minimum": 0, "maximum": 65535},
        "model_name": {"type": "string", "minLength": 1},
        "device_kind": {"enum": ["keyboard", "mouse"]},
        "transport_variant": {"const": "wired"},
        "class_name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "source_path": {"type": "string"},
        "source_line": {"type": "integer", "minimum": 1}
      }
    }
  }
}
