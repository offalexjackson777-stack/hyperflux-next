{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperflux.dev/schemas/publication-privacy-v1.json",
  "title": "HyperFlux publishable-tree privacy contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "scope",
    "normalization",
    "private_overlay_sha256",
    "forbidden_term_sha256",
    "allowed_protocol_notation"
  ],
  "properties": {
    "$schema": {"const": "../schemas/publication-privacy.schema.json"},
    "schema": {"const": "hyperflux-publication-privacy-v1"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tracked_and_unignored_files_only", "paths_scanned", "utf8_text_scanned", "binary_payloads_ascii_scanned", "maximum_text_file_bytes"],
      "properties": {
        "tracked_and_unignored_files_only": {"const": true},
        "paths_scanned": {"const": true},
        "utf8_text_scanned": {"const": true},
        "binary_payloads_ascii_scanned": {"const": true},
        "maximum_text_file_bytes": {"const": 33554432}
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unicode_casefold", "non_alphanumeric_separator", "maximum_words_per_term"],
      "properties": {
        "unicode_casefold": {"const": true},
        "non_alphanumeric_separator": {"const": true},
        "maximum_words_per_term": {"const": 4}
      }
    },
    "private_overlay_sha256": {"$ref": "#/$defs/sha256"},
    "forbidden_term_sha256": {
      "type": "array",
      "minItems": 8,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "word_count", "sha256"],
        "properties": {
          "id": {"type": "string", "pattern": "^private-term-[0-9]{2}$"},
          "word_count": {"type": "integer", "minimum": 1, "maximum": 4},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "allowed_protocol_notation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens", "reason"],
      "properties": {
        "tokens": {"const": ["ai"]},
        "reason": {"const": "D-Bus and OpenRazer signature notation is protocol data, not authorship metadata."}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
