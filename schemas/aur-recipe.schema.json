{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperflux.dev/schemas/aur-recipe-v1.json",
  "title": "HyperFlux source-built AUR recipe authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "source",
    "packaging_license",
    "makedepends",
    "options",
    "options_rule"
  ],
  "properties": {
    "$schema": {"const": "../schemas/aur-recipe.schema.json"},
    "schema": {"const": "hyperflux-aur-recipe-v1"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "repository", "publication_reference", "rule"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "repository": {"type": "string", "pattern": "^https://[A-Za-z0-9./_-]+\\.git$"},
        "publication_reference": {"const": "signed-tag"},
        "rule": {"$ref": "#/$defs/text"}
      }
    },
    "packaging_license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "copyright", "rule"],
      "properties": {
        "spdx": {"const": "0BSD"},
        "copyright": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 .,-]{0,79}$"},
        "rule": {"$ref": "#/$defs/text"}
      }
    },
    "makedepends": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9+_.-]{0,63}$"}
    },
    "options": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"enum": ["!strip", "!debug", "!lto"]}
    },
    "options_rule": {"$ref": "#/$defs/text"}
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    }
  }
}
