{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperflux.dev/schemas/openrazer-userspace-capability-catalog.schema.json",
  "title": "HyperFlux OpenRazer userspace capability catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "upstream",
    "policy_sha256",
    "service",
    "root",
    "devices",
    "source_files"
  ],
  "properties": {
    "$schema": { "const": "../../schemas/openrazer-userspace-capability-catalog.schema.json" },
    "schema": { "const": "hyperflux-openrazer-userspace-capability-catalog-v1" },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository", "version", "commit", "license_expression"],
      "properties": {
        "id": { "const": "openrazer" },
        "repository": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "license_expression": { "type": "string", "minLength": 1 }
      }
    },
    "policy_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bus_name", "root_path", "device_path_prefix"],
      "properties": {
        "bus_name": { "const": "org.razer" },
        "root_path": { "const": "/org/razer" },
        "device_path_prefix": { "const": "/org/razer/device/" }
      }
    },
    "root": { "$ref": "#/$defs/surface" },
    "devices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile_id",
          "identity",
          "source",
          "required",
          "semantic_probes",
          "features"
        ],
        "properties": {
          "profile_id": { "type": "string", "pattern": "^child\\.[a-z0-9.-]+$" },
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["vendor_id", "product_id", "model_name", "device_kind"],
            "properties": {
              "vendor_id": { "type": "integer", "minimum": 1, "maximum": 65535 },
              "product_id": { "type": "integer", "minimum": 1, "maximum": 65535 },
              "model_name": { "type": "string", "minLength": 1, "maxLength": 127 },
              "device_kind": { "enum": ["keyboard", "mouse"] }
            }
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "class_name", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "class_name": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            }
          },
          "required": { "$ref": "#/$defs/methods" },
          "semantic_probes": { "$ref": "#/$defs/methods" },
          "features": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "requirement", "methods"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,63}$" },
                "requirement": { "enum": ["required", "optional"] },
                "methods": { "$ref": "#/$defs/methods" }
              }
            }
          }
        }
      }
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  },
  "$defs": {
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "interface", "member", "in_signature", "out_signature"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,127}$" },
        "interface": { "type": "string", "minLength": 1 },
        "member": { "type": "string", "minLength": 1 },
        "in_signature": { "type": "string" },
        "out_signature": { "type": "string" }
      }
    },
    "methods": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/method" }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "interface", "member", "signature"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,127}$" },
        "interface": { "type": "string", "minLength": 1 },
        "member": { "type": "string", "minLength": 1 },
        "signature": { "type": "string" }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["methods", "diagnostic_methods", "signals"],
      "properties": {
        "methods": { "$ref": "#/$defs/methods" },
        "diagnostic_methods": { "$ref": "#/$defs/methods" },
        "signals": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/signal" }
        }
      }
    }
  }
}
