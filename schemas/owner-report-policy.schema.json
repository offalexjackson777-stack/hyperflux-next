{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperflux.dev/schemas/owner-report-policy-v1.json",
  "title": "HyperFlux owner report acceptance rules",
  "description": "What a hardware report from a device owner must show before a device on the receiver's list is marked as confirmed by owners.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "report",
    "receiver",
    "device",
    "confirmations",
    "minimum_reports",
    "limitations"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "const": "hyperflux-owner-report-policy-v1"
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "schema_path",
        "producer",
        "companion_endpoint",
        "companion_states",
        "minimum_version",
        "maximum_bytes",
        "refused_finding_severities"
      ],
      "properties": {
        "schema": {
          "const": "hyperflux-local-qualification-v1"
        },
        "schema_path": {
          "const": "apps/device-qualification/contracts/local-qualification-view.schema.json"
        },
        "producer": {
          "const": "hyperfluxctl qualification"
        },
        "companion_endpoint": {
          "const": "http://127.0.0.1:47821"
        },
        "companion_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ready"
            ]
          }
        },
        "minimum_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "maximum_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 4194304
        },
        "refused_finding_severities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "warning",
              "error",
              "critical"
            ]
          }
        }
      }
    },
    "receiver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_kind",
        "lifecycles",
        "require_current_profile_digest"
      ],
      "properties": {
        "profile_kind": {
          "const": "receiver"
        },
        "lifecycles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "active",
              "recovering"
            ]
          }
        },
        "require_current_profile_digest": {
          "type": "boolean"
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible_tier",
        "presence",
        "support"
      ],
      "properties": {
        "eligible_tier": {
          "const": "source-qualified-operational"
        },
        "presence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "active",
              "sleeping"
            ]
          }
        },
        "support": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "unknown",
              "identified"
            ]
          }
        }
      }
    },
    "confirmations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "lighting"
      ],
      "properties": {
        "required": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "input"
            ]
          }
        },
        "lighting": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "integration"
            ],
            "properties": {
              "id": {
                "enum": [
                  "openrazer-lighting",
                  "openrgb-lighting"
                ]
              },
              "integration": {
                "enum": [
                  "openrazer",
                  "openrgb"
                ]
              }
            }
          }
        }
      }
    },
    "minimum_reports": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    }
  }
}
