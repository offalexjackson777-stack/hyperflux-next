{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperflux.dev/schemas/openrazer-native-command-policy-v1.json",
  "title": "OpenRazer native command policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "upstream_id", "source_commit", "report_size", "families"],
  "properties": {
    "$schema": {"type": "string"},
    "schema": {"const": "hyperflux-openrazer-native-command-policy-v1"},
    "upstream_id": {"const": "openrazer"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "report_size": {"const": 90},
    "families": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/family"}
    }
  },
  "$defs": {
    "method": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,127}$"},
    "function": {"type": "string", "pattern": "^razer_[a-z0-9_]+$"},
    "field": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "offset", "bytes"],
          "properties": {
            "kind": {"const": "exact"},
            "offset": {"type": "integer", "minimum": 0, "maximum": 79},
            "bytes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 80,
              "items": {"type": "integer", "minimum": 0, "maximum": 255}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "offset", "values"],
          "properties": {
            "kind": {"const": "one-of"},
            "offset": {"type": "integer", "minimum": 0, "maximum": 79},
            "values": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "uniqueItems": true,
              "items": {"type": "integer", "minimum": 0, "maximum": 255}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "offset", "minimum", "maximum"],
          "properties": {
            "kind": {"const": "u8-range"},
            "offset": {"type": "integer", "minimum": 0, "maximum": 79},
            "minimum": {"type": "integer", "minimum": 0, "maximum": 255},
            "maximum": {"type": "integer", "minimum": 0, "maximum": 255}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "offset", "minimum", "maximum"],
          "properties": {
            "kind": {"const": "be16-range"},
            "offset": {"type": "integer", "minimum": 0, "maximum": 78},
            "minimum": {"type": "integer", "minimum": 0, "maximum": 65535},
            "maximum": {"type": "integer", "minimum": 0, "maximum": 65535}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "offset", "pixels"],
          "properties": {
            "kind": {"const": "rgb"},
            "offset": {"type": "integer", "minimum": 0, "maximum": 79},
            "pixels": {"type": "integer", "minimum": 1, "maximum": 26}
          }
        }
      ]
    },
    "matcher": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "fields"],
          "properties": {
            "kind": {"const": "fields"},
            "fields": {
              "type": "array",
              "minItems": 1,
              "maxItems": 80,
              "items": {"$ref": "#/$defs/field"}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "rows", "columns"],
          "properties": {
            "kind": {"const": "custom-frame"},
            "rows": {"type": "integer", "minimum": 1, "maximum": 32},
            "columns": {"type": "integer", "minimum": 1, "maximum": 25}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "maximum_stages", "minimum_dpi", "maximum_dpi"],
          "properties": {
            "kind": {"const": "dpi-stages"},
            "maximum_stages": {"type": "integer", "minimum": 1, "maximum": 5},
            "minimum_dpi": {"type": "integer", "minimum": 1, "maximum": 65535},
            "maximum_dpi": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "functions"],
      "properties": {
        "path": {"enum": ["driver/razerchromacommon.c", "driver/razerkbd_driver.c", "driver/razermouse_driver.c"]},
        "functions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/function"}
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "methods", "command_class", "command_id", "data_size", "matcher", "sources"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,127}$"},
        "methods": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/method"}
        },
        "command_class": {"type": "integer", "minimum": 0, "maximum": 255},
        "command_id": {"type": "integer", "minimum": 0, "maximum": 127},
        "data_size": {"type": "integer", "minimum": 0, "maximum": 80},
        "matcher": {"$ref": "#/$defs/matcher"},
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/source"}
        }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["device_kind", "rules"],
      "properties": {
        "device_kind": {"enum": ["keyboard", "mouse"]},
        "rules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {"$ref": "#/$defs/rule"}
        }
      }
    }
  }
}
