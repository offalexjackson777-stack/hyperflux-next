{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperflux.dev/schemas/debian-package-build-v1.json",
  "title": "HyperFlux Debian-format Core package build manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "source",
    "distribution",
    "release",
    "maturity",
    "architecture",
    "packages"
  ],
  "properties": {
    "$schema": {
      "const": "https://hyperflux.dev/schemas/debian-package-build-v1.json"
    },
    "schema": {
      "const": "hyperflux-debian-package-build-v1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "source_date_epoch",
        "distribution_catalog_sha256",
        "arch_split_sha256",
        "artifact_manifest_sha256"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_date_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4102444800
        },
        "distribution_catalog_sha256": {
          "$ref": "#/$defs/digest"
        },
        "arch_split_sha256": {
          "$ref": "#/$defs/digest"
        },
        "artifact_manifest_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "distribution": {
      "enum": [
        "ubuntu",
        "debian"
      ]
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distribution",
        "version",
        "codename"
      ],
      "properties": {
        "distribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]{1,2}(\\.[0-9]{2})?$"
        },
        "codename": {
          "type": "string",
          "pattern": "^[a-z]{3,16}$"
        }
      }
    },
    "maturity": {
      "enum": [
        "ci-only",
        "published"
      ]
    },
    "architecture": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,31}$"
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/package"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output",
        "distribution_component",
        "name",
        "version",
        "architecture",
        "depends",
        "file",
        "sha256",
        "size",
        "payload_sha256",
        "payload_files"
      ],
      "properties": {
        "output": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "distribution_component": {
          "enum": [
            "linux"
          ]
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9+.-]{1,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9][A-Za-z0-9.+~]{0,63}-[0-9]+$"
        },
        "architecture": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,31}$"
        },
        "depends": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9+.-]{1,63}( \\((<<|<=|=|>=|>>) [0-9][A-Za-z0-9.+~-]{0,63}\\))?$"
          }
        },
        "file": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9+.-]{1,63}_[0-9][A-Za-z0-9.+~-]{0,63}_[a-z0-9-]{1,31}\\.deb$"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648
        },
        "payload_sha256": {
          "$ref": "#/$defs/digest"
        },
        "payload_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      }
    }
  }
}
