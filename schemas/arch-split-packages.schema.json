{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperflux.dev/schemas/arch-split-packages-v1.json",
  "title": "HyperFlux four-output Arch package topology",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "pkgbase",
    "first_release",
    "first_release_rule",
    "architectures",
    "editions",
    "outputs",
    "retired_relations"
  ],
  "properties": {
    "$schema": {"const": "../schemas/arch-split-packages.schema.json"},
    "schema": {"const": "hyperflux-arch-split-packages-v1"},
    "pkgbase": {"$ref": "#/$defs/packageName"},
    "first_release": {"$ref": "#/$defs/release"},
    "first_release_rule": {"$ref": "#/$defs/text"},
    "architectures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9_]{1,31}$"}
    },
    "editions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["linux", "full"],
      "properties": {
        "linux": {"$ref": "#/$defs/identifier"},
        "full": {"$ref": "#/$defs/identifier"}
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/output"}
    },
    "retired_relations": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["output", "relation", "reason", "expires_before_release"],
        "properties": {
          "output": {"$ref": "#/$defs/identifier"},
          "relation": {"$ref": "#/$defs/packageExpression"},
          "reason": {"$ref": "#/$defs/text"},
          "expires_before_release": {"$ref": "#/$defs/release"}
        }
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "packageName": {"type": "string", "pattern": "^[a-z][a-z0-9+_.-]{0,63}$"},
    "release": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]+)*-[1-9][0-9]*$"},
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "packageExpression": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9+_.() >=~@-]{0,95}$"
    },
    "relationList": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/packageExpression"}
    },
    "identifierList": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "package_name",
        "edition",
        "description",
        "licenses",
        "builds",
        "payloads",
        "dependency_roles",
        "sibling_dependencies",
        "dependencies",
        "optional_dependencies",
        "conflicts",
        "provides",
        "replaces"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "package_name": {"$ref": "#/$defs/packageName"},
        "edition": {"enum": ["linux", "full"]},
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "licenses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]{0,63}$"}
        },
        "builds": {"$ref": "#/$defs/identifierList"},
        "payloads": {"$ref": "#/$defs/identifierList"},
        "dependency_roles": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"enum": ["dkms", "c-runtime", "compiler-runtime", "service-manager", "device-manager"]}
        },
        "sibling_dependencies": {"$ref": "#/$defs/identifierList"},
        "dependencies": {"$ref": "#/$defs/relationList"},
        "optional_dependencies": {"enum": ["none", "edition"]},
        "conflicts": {"$ref": "#/$defs/relationList"},
        "provides": {"$ref": "#/$defs/relationList"},
        "replaces": {"$ref": "#/$defs/relationList"}
      }
    }
  }
}
