{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperflux.dev/schemas/public-evidence-sources-v1.json",
  "title": "HyperFlux public evidence sources",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema", "sources"],
  "properties": {
    "$schema": {"const": "../../schemas/public-evidence-sources.schema.json"},
    "schema": {"const": "hyperflux-public-evidence-sources-v1"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "path", "sha256"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,95}$"},
          "role": {"type": "string", "minLength": 1, "maxLength": 240},
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
