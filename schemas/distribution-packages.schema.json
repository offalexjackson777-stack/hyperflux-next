{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperflux.dev/schemas/distribution-packages-v2.json",
  "title": "HyperFlux split distribution package contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema", "metadata", "targets"],
  "properties": {
    "$schema": {"const": "../schemas/distribution-packages.schema.json"},
    "schema": {"const": "hyperflux-distribution-packages-v2"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "homepage", "licenses"],
      "properties": {
        "description": {"$ref": "#/$defs/description"},
        "homepage": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 256
        },
        "licenses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]{0,63}$"}
        }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arch", "ubuntu", "debian", "fedora", "opensuse"],
      "properties": {
        "arch": {"$ref": "#/$defs/target"},
        "ubuntu": {"$ref": "#/$defs/debTarget"},
        "debian": {"$ref": "#/$defs/debTarget"},
        "fedora": {"$ref": "#/$defs/rpmTarget"},
        "opensuse": {"$ref": "#/$defs/rpmTarget"}
      }
    }
  },
  "$defs": {
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "packageExpression": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9+_.() >=~@-]{0,95}$"
    },
    "debianRelation": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9+.-]{1,63}( \\((<<|<=|=|>=|>>) [0-9][A-Za-z0-9.+~-]{0,63}\\))?$"
    },
    "rpmRelation": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_+.-]{1,63}( (<=|>=|=|<|>) [0-9][A-Za-z0-9.+~^_]{0,63}(-[0-9][A-Za-z0-9.+~^_]{0,31})?)?$"
    },
    "dependencyRoles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dkms", "c-runtime", "compiler-runtime", "service-manager", "device-manager"],
      "properties": {
        "dkms": {"$ref": "#/$defs/packageExpression"},
        "c-runtime": {"$ref": "#/$defs/packageExpression"},
        "compiler-runtime": {"$ref": "#/$defs/packageExpression"},
        "service-manager": {"$ref": "#/$defs/packageExpression"},
        "device-manager": {"$ref": "#/$defs/packageExpression"}
      }
    },
    "architectures": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 8,
      "propertyNames": {"pattern": "^[A-Za-z0-9_.-]{1,127}$"},
      "additionalProperties": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,31}$"}
    },
    "relationList": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/packageExpression"}
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_name",
        "description",
        "dependency_roles",
        "dependencies",
        "optional_dependencies",
        "conflicts",
        "provides",
        "replaces"
      ],
      "properties": {
        "package_name": {"type": "string", "pattern": "^[a-z][a-z0-9+_.-]{0,63}$"},
        "description": {"$ref": "#/$defs/description"},
        "dependency_roles": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"enum": ["dkms", "c-runtime", "compiler-runtime", "service-manager", "device-manager"]}
        },
        "dependencies": {
          "type": "array",
          "maxItems": 24,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/packageExpression"}
        },
        "optional_dependencies": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["package", "purpose"],
            "properties": {
              "package": {"$ref": "#/$defs/packageExpression"},
              "purpose": {"$ref": "#/$defs/description"}
            }
          }
        },
        "conflicts": {"$ref": "#/$defs/relationList"},
        "provides": {"$ref": "#/$defs/relationList"},
        "replaces": {"$ref": "#/$defs/relationList"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_format", "maturity", "architectures", "dependency_roles", "components"],
      "properties": {
        "package_format": {"const": "pacman"},
        "maturity": {"const": "published"},
        "architectures": {"$ref": "#/$defs/architectures"},
        "dependency_roles": {"$ref": "#/$defs/dependencyRoles"},
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": ["linux", "full"],
          "properties": {
            "linux": {"$ref": "#/$defs/component"},
            "full": {"$ref": "#/$defs/component"}
          }
        }
      }
    },
    "debTarget": {
      "description": "A Debian-format target. It carries Core and Full; Full there carries the OpenRGB plugin only when the release ships an OpenRGB that can load it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["package_format", "maturity", "release", "architectures", "dependency_roles", "components"],
      "properties": {
        "package_format": {"const": "deb"},
        "maturity": {"enum": ["ci-only", "published"]},
        "release": {
          "type": "object",
          "additionalProperties": false,
          "required": ["distribution", "version", "codename", "c_runtime_version"],
          "properties": {
            "distribution": {"type": "string", "pattern": "^[A-Z][A-Za-z]{1,31}$"},
            "version": {"type": "string", "pattern": "^[0-9]{1,2}(\\.[0-9]{2})?$"},
            "codename": {"type": "string", "pattern": "^[a-z]{2,32}$"},
            "c_runtime_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}
          }
        },
        "architectures": {"$ref": "#/$defs/architectures"},
        "dependency_roles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dkms", "c-runtime", "compiler-runtime", "service-manager", "device-manager"],
          "properties": {
            "dkms": {"$ref": "#/$defs/debianRelation"},
            "c-runtime": {"$ref": "#/$defs/debianRelation"},
            "compiler-runtime": {"$ref": "#/$defs/debianRelation"},
            "service-manager": {"$ref": "#/$defs/debianRelation"},
            "device-manager": {"$ref": "#/$defs/debianRelation"}
          }
        },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": ["linux", "full"],
          "properties": {
            "linux": {"$ref": "#/$defs/component"},
            "full": {"$ref": "#/$defs/component"}
          }
        }
      }
    },
    "rpmTarget": {
      "description": "An RPM-format target. It carries Core and Full; Full there has no OpenRGB plugin, because the release ships no OpenRGB that can load it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["package_format", "maturity", "release", "architectures", "dependency_roles", "components"],
      "properties": {
        "package_format": {"const": "rpm"},
        "maturity": {"enum": ["ci-only", "published"]},
        "release": {
          "type": "object",
          "additionalProperties": false,
          "required": ["distribution", "version", "c_runtime_version"],
          "properties": {
            "distribution": {"type": "string", "pattern": "^[A-Za-z][A-Za-z]{1,31}$"},
            "version": {"type": "string", "pattern": "^([0-9]{1,2}(\\.[0-9]{1,2})?|[A-Z][a-z]{2,31})$"},
            "c_runtime_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}
          }
        },
        "architectures": {"$ref": "#/$defs/architectures"},
        "dependency_roles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dkms", "c-runtime", "compiler-runtime", "service-manager", "device-manager"],
          "properties": {
            "dkms": {"$ref": "#/$defs/rpmRelation"},
            "c-runtime": {"$ref": "#/$defs/rpmRelation"},
            "compiler-runtime": {"$ref": "#/$defs/rpmRelation"},
            "service-manager": {"$ref": "#/$defs/rpmRelation"},
            "device-manager": {"$ref": "#/$defs/rpmRelation"}
          }
        },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": ["linux", "full"],
          "properties": {
            "linux": {"$ref": "#/$defs/component"},
            "full": {"$ref": "#/$defs/component"}
          }
        }
      }
    }
  }
}
