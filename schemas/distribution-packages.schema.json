{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperflux.dev/schemas/distribution-packages-v2.json",
  "title": "HyperFlux split distribution package contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema", "metadata", "targets"],
  "properties": {
    "$schema": {"const": "../schemas/distribution-packages.schema.json"},
    "schema": {"const": "hyperflux-distribution-packages-v2"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "homepage", "licenses"],
      "properties": {
        "description": {"$ref": "#/$defs/description"},
        "homepage": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 256
        },
        "licenses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]{0,63}$"}
        }
      }
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arch"],
      "properties": {
        "arch": {"$ref": "#/$defs/target"}
      }
    }
  },
  "$defs": {
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "packageExpression": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9+_.() >=~@-]{0,95}$"
    },
    "relationList": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/packageExpression"}
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_name",
        "description",
        "dependency_roles",
        "dependencies",
        "optional_dependencies",
        "conflicts",
        "provides",
        "replaces"
      ],
      "properties": {
        "package_name": {"type": "string", "pattern": "^[a-z][a-z0-9+_.-]{0,63}$"},
        "description": {"$ref": "#/$defs/description"},
        "dependency_roles": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"enum": ["dkms", "c-runtime", "compiler-runtime", "service-manager", "device-manager"]}
        },
        "dependencies": {
          "type": "array",
          "maxItems": 24,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/packageExpression"}
        },
        "optional_dependencies": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["package", "purpose"],
            "properties": {
              "package": {"$ref": "#/$defs/packageExpression"},
              "purpose": {"$ref": "#/$defs/description"}
            }
          }
        },
        "conflicts": {"$ref": "#/$defs/relationList"},
        "provides": {"$ref": "#/$defs/relationList"},
        "replaces": {"$ref": "#/$defs/relationList"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architectures", "dependency_roles", "components"],
      "properties": {
        "architectures": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 8,
          "propertyNames": {"pattern": "^[A-Za-z0-9_.-]{1,127}$"},
          "additionalProperties": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,31}$"}
        },
        "dependency_roles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dkms", "c-runtime", "compiler-runtime", "service-manager", "device-manager"],
          "properties": {
            "dkms": {"$ref": "#/$defs/packageExpression"},
            "c-runtime": {"$ref": "#/$defs/packageExpression"},
            "compiler-runtime": {"$ref": "#/$defs/packageExpression"},
            "service-manager": {"$ref": "#/$defs/packageExpression"},
            "device-manager": {"$ref": "#/$defs/packageExpression"}
          }
        },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": ["linux", "full"],
          "properties": {
            "linux": {"$ref": "#/$defs/component"},
            "full": {"$ref": "#/$defs/component"}
          }
        }
      }
    }
  }
}
