{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperflux.dev/schemas/documentation-review-v1.json",
  "title": "HyperFlux critical page review manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema", "common_checks", "pages"],
  "properties": {
    "$schema": {"const": "../schemas/documentation-review.schema.json"},
    "schema": {"const": "hyperflux-documentation-review-v1"},
    "common_checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/check"}
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/page"}
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!/)(?!build/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "check": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "checks", "authorities"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/check"}
        },
        "authorities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/path"}
        }
      }
    }
  }
}
