{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperflux.dev/schemas/rpm-package-build-v1.json",
  "title": "HyperFlux RPM Core package build manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "source",
    "distribution",
    "release",
    "maturity",
    "architecture",
    "packages"
  ],
  "properties": {
    "$schema": {
      "const": "https://hyperflux.dev/schemas/rpm-package-build-v1.json"
    },
    "schema": {
      "const": "hyperflux-rpm-package-build-v1"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "source_date_epoch",
        "distribution_catalog_sha256",
        "arch_split_sha256",
        "artifact_manifest_sha256"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_date_epoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4102444800
        },
        "distribution_catalog_sha256": {
          "$ref": "#/$defs/digest"
        },
        "arch_split_sha256": {
          "$ref": "#/$defs/digest"
        },
        "artifact_manifest_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "distribution": {
      "enum": [
        "fedora",
        "opensuse"
      ]
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "distribution",
        "version"
      ],
      "properties": {
        "distribution": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z]{1,31}$"
        },
        "version": {
          "type": "string",
          "pattern": "^([0-9]{1,2}(\\.[0-9]{1,2})?|[A-Z][a-z]{2,31})$"
        }
      }
    },
    "maturity": {
      "enum": [
        "ci-only",
        "published"
      ]
    },
    "architecture": {
      "type": "string",
      "pattern": "^[a-z0-9_]{1,31}$"
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/package"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output",
        "distribution_component",
        "name",
        "version",
        "release",
        "architecture",
        "requires",
        "file",
        "sha256",
        "size",
        "payload_sha256",
        "payload_files"
      ],
      "properties": {
        "output": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "distribution_component": {
          "enum": [
            "linux"
          ]
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9+.-]{1,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9][A-Za-z0-9.+~^_]{0,63}$"
        },
        "release": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,5}$"
        },
        "architecture": {
          "type": "string",
          "pattern": "^(noarch|[a-z0-9_]{1,31})$"
        },
        "requires": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_+.-]{1,63}( (<=|>=|=|<|>) [0-9][A-Za-z0-9.+~^_]{0,63}(-[0-9][A-Za-z0-9.+~^_]{0,31})?)?$"
          }
        },
        "file": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9+.-]{1,63}-[0-9][A-Za-z0-9.+~^_]{0,63}-[1-9][0-9]{0,5}\\.(noarch|[a-z0-9_]{1,31})\\.rpm$"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648
        },
        "payload_sha256": {
          "$ref": "#/$defs/digest"
        },
        "payload_files": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      }
    }
  }
}
