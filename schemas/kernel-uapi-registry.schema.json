{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperflux.dev/schemas/kernel-uapi-registry-v1.json",
  "title": "HyperFlux kernel UAPI registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema", "entries"],
  "properties": {
    "$schema": {"const": "../schemas/kernel-uapi-registry.schema.json"},
    "schema": {"const": "hyperflux-kernel-uapi-registry-v1"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["abi_version", "catalog", "schema", "schema_ref", "version_macro", "role"],
        "properties": {
          "abi_version": {"type": "integer", "minimum": 1, "maximum": 4294967295},
          "catalog": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*\\.json$"},
          "schema": {"type": "string", "pattern": "^hyperflux-kernel-uapi-[a-z0-9-]+$"},
          "schema_ref": {"type": "string", "pattern": "^\\.\\./schemas/[a-z][a-z0-9_-]*\\.schema\\.json$"},
          "version_macro": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "role": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
        }
      }
    }
  }
}
