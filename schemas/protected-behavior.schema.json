{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperflux.dev/schemas/protected-behavior-v1.json",
  "title": "Protected HyperFlux behavior baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source_revision", "software_baseline", "protected_surfaces", "known_gaps", "change_policy"],
  "properties": {
    "$schema": {"type": "string"},
    "schema": {"const": "hyperflux-protected-behavior-v1"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "software_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane", "status", "required_nodes"],
      "properties": {
        "lane": {"const": "fast"},
        "status": {"const": "passed"},
        "required_nodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
        }
      }
    },
    "protected_surfaces": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/protected-surface"}
    },
    "known_gaps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/known-gap"}
    },
    "change_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integration_only_prefixes", "protected_prefixes", "advanced_capability_prefixes", "approval_required_when", "required_reverification"],
      "properties": {
        "integration_only_prefixes": {"$ref": "#/$defs/paths"},
        "protected_prefixes": {"$ref": "#/$defs/paths"},
        "advanced_capability_prefixes": {"$ref": "#/$defs/paths"},
        "approval_required_when": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["advanced-change-touches-protected-prefix", "qualified-profile-runtime-digest-changes", "public-protocol-semantics-change"]}
        },
        "required_reverification": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
        }
      }
    }
  },
  "$defs": {
    "paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9_.+/-]+$"}
    },
    "protected-surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "summary", "authority_paths", "claim_ids", "verification_nodes"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9.-]+$"},
        "summary": {"type": "string", "minLength": 1},
        "authority_paths": {"$ref": "#/$defs/paths"},
        "claim_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^claim\\.[a-z0-9.-]+$"}
        },
        "verification_nodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
        }
      }
    },
    "known-gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "summary", "forbidden_claim", "required_evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9.-]+$"},
        "summary": {"type": "string", "minLength": 1},
        "forbidden_claim": {"type": "string", "minLength": 1},
        "required_evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
