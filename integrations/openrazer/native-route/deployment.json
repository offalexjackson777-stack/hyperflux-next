{
  "$schema": "../../../schemas/openrazer-native-deployment.schema.json",
  "schema": "hyperflux-openrazer-native-deployment-v2",
  "relay": {
    "executable_path": "/usr/lib/hyperflux-next/hyperflux-next-uhid-relay",
    "service_unit": "hyperflux-next-openrazer-relay.service",
    "preflight_service_unit": "hyperflux-next-openrazer-driver-preflight.service",
    "uhid_device": "/dev/uhid",
    "automatic_restart": false
  },
  "driver": {
    "dkms_name": "openrazer-driver",
    "dkms_version": "3.12.4",
    "source_directory": "/usr/src/openrazer-driver-3.12.4",
    "modules": ["razeraccessory", "razerkbd", "razerkraken", "razermouse"]
  },
  "access": {
    "group": "openrazer",
    "udev_rules_source": "install_files/udev/99-razer.rules",
    "udev_rules_path": "/usr/lib/udev/rules.d/99-razer.rules",
    "mount_helper_source": "install_files/udev/razer_mount",
    "mount_helper_path": "/usr/lib/udev/razer_mount",
    "sysusers_path": "/usr/lib/sysusers.d/openrazer.conf"
  },
  "key_events": {
    "udev_rules_path": "/usr/lib/udev/rules.d/70-hyperflux-next-openrazer-keys.rules",
    "access": "active-seat-user",
    "links": [
      {
        "profile_id": "child.razer.deathstalker-v2-pro-tkl.0296",
        "receiver_profile_id": "receiver.razer.hyperflux-v2.1532-00cf",
        "receiver_usb_interface": 1,
        "link_name": "hyperflux-next-DSV2Pro_TKL_000000000000-if01-event-mouse"
      }
    ]
  },
  "compatibility": {
    "verified_upstream_version": "3.12.4",
    "daemon_executable_path": "/usr/bin/openrazer-daemon",
    "version_argument": "--version",
    "package_release_policy": "ignored",
    "userspace_version_policy": "diagnostic-only",
    "runtime_capability": {
      "modinfo_field": "hyperflux_native_transport",
      "expected_value": "razer-feature-report-v1",
      "modules": ["razerkbd", "razermouse"]
    }
  }
}
