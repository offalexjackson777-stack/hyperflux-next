--- a/driver/razercommon.c
+++ b/driver/razercommon.c
@@ -12,6 +12,95 @@
 
 #include "razercommon.h"
 
+#define RAZER_HYPERFLUX_PHYS_PREFIX "hyperflux-next/native/v1/"
+
+static const u8 razer_hyperflux_descriptor[] = {
+    0x06, 0x00, 0xff, 0x09, 0x01, 0xa1, 0x01, 0x15, 0x00, 0x26,
+    0xff, 0x00, 0x75, 0x08, 0x95, 0x5a, 0xb1, 0x02, 0xc0,
+};
+
+static const u8 razer_hyperflux_error_magic[] = {
+    'H', 'F', 'X', 'N', 'E', 'R', 'R', '1',
+};
+
+bool razer_is_hyperflux_native(struct hid_device *hdev)
+{
+    const char *instance;
+
+    if (hdev->bus != BUS_VIRTUAL ||
+        !hdev->phys[0] ||
+        hdev->vendor != USB_VENDOR_ID_RAZER ||
+        strncmp(hdev->phys, RAZER_HYPERFLUX_PHYS_PREFIX,
+                sizeof(RAZER_HYPERFLUX_PHYS_PREFIX) - 1) != 0 ||
+        hdev->dev_rsize != sizeof(razer_hyperflux_descriptor) ||
+        !hdev->dev_rdesc ||
+        memcmp(hdev->dev_rdesc, razer_hyperflux_descriptor,
+               sizeof(razer_hyperflux_descriptor)) != 0)
+        return false;
+
+    instance = hdev->phys + sizeof(RAZER_HYPERFLUX_PHYS_PREFIX) - 1;
+    if (!*instance)
+        return false;
+    while (*instance) {
+        if (!(*instance >= 'a' && *instance <= 'z') &&
+            !(*instance >= '0' && *instance <= '9') &&
+            *instance != '-')
+            return false;
+        instance++;
+    }
+    return true;
+}
+
+bool razer_hyperflux_error_is_uncertain(int error)
+{
+    return error == RAZER_HYPERFLUX_TRANSPORT_MAY_HAVE_BEEN_SENT;
+}
+
+static int razer_decode_hyperflux_error(const struct razer_report *report)
+{
+    const u8 *bytes = (const u8 *)report;
+    size_t index;
+
+    if (memcmp(bytes, razer_hyperflux_error_magic,
+               sizeof(razer_hyperflux_error_magic)) != 0 ||
+        bytes[8] != 1 || bytes[88] != 0x5a || bytes[89] != 0xa5)
+        return 0;
+    for (index = 10; index < 88; index++) {
+        if (bytes[index] != 0)
+            return 0;
+    }
+    if (bytes[9] == 1)
+        return RAZER_HYPERFLUX_TRANSPORT_NOT_SENT;
+    if (bytes[9] == 2)
+        return RAZER_HYPERFLUX_TRANSPORT_MAY_HAVE_BEEN_SENT;
+    return 0;
+}
+
+int razer_get_hyperflux_response(struct hid_device *hdev,
+                                 struct razer_report *request_report,
+                                 struct razer_report *response_report)
+{
+    int result;
+
+    if (!razer_is_hyperflux_native(hdev))
+        return -ENODEV;
+
+    result = hid_hw_raw_request(hdev, 0, (u8 *)request_report,
+                                sizeof(*request_report), HID_FEATURE_REPORT,
+                                HID_REQ_SET_REPORT);
+    if (result != sizeof(*request_report))
+        return RAZER_HYPERFLUX_TRANSPORT_MAY_HAVE_BEEN_SENT;
+
+    memset(response_report, 0, sizeof(*response_report));
+    result = hid_hw_raw_request(hdev, 0, (u8 *)response_report,
+                                sizeof(*response_report), HID_FEATURE_REPORT,
+                                HID_REQ_GET_REPORT);
+    if (result != sizeof(*response_report))
+        return RAZER_HYPERFLUX_TRANSPORT_MAY_HAVE_BEEN_SENT;
+
+    return razer_decode_hyperflux_error(response_report);
+}
