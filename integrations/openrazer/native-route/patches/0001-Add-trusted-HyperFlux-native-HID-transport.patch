+static bool razer_kbd_transport_supported(struct hid_device *hdev)
+{
+    const struct hid_device_id *identity;
+
+    if (hdev->bus == BUS_USB)
+        return true;
+    if (!razer_is_hyperflux_native(hdev))
+        return false;
+    for (identity = razer_devices; identity->vendor; identity++) {
+        if (identity->bus == BUS_USB &&
+            identity->vendor == hdev->vendor &&
+            identity->product == hdev->product)
+            return true;
+    }
+    return false;
+}
